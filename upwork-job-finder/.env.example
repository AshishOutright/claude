# ---- Upwork API (https://www.upwork.com/developer/keys) ----
# Leave blank to run in demo mode with sample jobs.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
# Must exactly match the callback URL registered with your Upwork API key
UPWORK_REDIRECT_URI=http://localhost:8001/auth/callback
# Optional: organization (tenant) id if your account has several
UPWORK_TENANT_ID=
# DEMO_MODE=true

# ---- Claude (proposal drafting) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
FREELANCER_PROFILE="CRM developer (SuiteCRM, SugarCRM, Vtiger, Salesforce) with 10+ years building custom modules, integrations and automation for SMBs."

# ---- Alerts ----
ALERT_INTERVAL_MINUTES=15
ALERT_MIN_SCORE=50
# Email (e.g. Gmail: smtp.gmail.com / 587 with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Telegram (create a bot with @BotFather, get chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
