# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Default model for new chats, and the list shown in the model picker
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5,claude-fable-5-1
# Max length of each reply, and how many earlier messages are sent as context
MAX_TOKENS=16000
HISTORY_LIMIT=40

# ---- Public hosting ----
# Set a password when the app is reachable from the internet. Leave blank on your own computer.
APP_PASSWORD=
